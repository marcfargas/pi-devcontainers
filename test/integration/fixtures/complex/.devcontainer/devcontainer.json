{
  "image": "mcr.microsoft.com/devcontainers/rust:1",
  "features": {
    "ghcr.io/devcontainers/features/rust:1": { "version": "latest" },
    "ghcr.io/devcontainers/features/git:1": {}
  },
  "mounts": [
    "source=cargo-cache,target=/usr/local/cargo/registry,type=volume"
  ],
  "postCreateCommand": {
    "install-deps": "cargo build",
    "setup-tools": "cargo install cargo-watch"
  },
  "remoteEnv": {
    "RUST_LOG": "debug",
    "CARGO_HOME": "/usr/local/cargo"
  },
  "forwardPorts": [8080],
  "customizations": {
    "vscode": {
      "extensions": ["rust-lang.rust-analyzer"]
    }
  }
}
