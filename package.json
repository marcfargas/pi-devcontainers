{
  "name": "pi-devcontainers-root",
  "private": true,
  "workspaces": [
    "packages/cli",
    "packages/feature",
    "packages/wrapper"
  ],
  "scripts": {
    "build": "npm run build -w packages/cli",
    "test": "vitest run",
    "test:watch": "vitest",
