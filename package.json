{
  "name": "pi-devcontainers-root",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "packages/cli",
    "packages/feature",
    "packages/wrapper"
  ],
  "scripts": {
    "build": "npm run build -w packages/cli",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "lint": "tsc --noEmit -p packages/cli/tsconfig.json",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "changeset publish"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.5.2",
    "@changesets/cli": "^2.29.8",
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
